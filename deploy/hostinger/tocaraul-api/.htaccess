RewriteEngine On

RewriteRule ^favicon.ico$ assets/icon-192.png [L]
RewriteRule ^$ home.php [QSA,L]
RewriteRule ^admin/?$ admin.php [QSA,L]
RewriteRule ^api/oauth/google/(?:start|callback)$ google_bar.php [QSA,L]
RewriteRule ^auth/google/(?:start|callback)$ google_bar.php [QSA,L]
RewriteRule ^bar/?$ owner.php [QSA,L]
RewriteRule ^player/?$ /bar [R=302,L]
RewriteRule ^tela/?$ /bar [R=302,L]
RewriteRule ^tv/?$ /bar [R=302,L]
RewriteRule ^privacy/?$ privacy.php [QSA,L]
RewriteRule ^parceiro/?$ partner.php [QSA,L]
RewriteRule ^cadastro/?$ signup.php [QSA,L]
RewriteRule ^manifest\.webmanifest$ manifest.php [QSA,L]
RewriteRule ^j/[A-Za-z0-9_-]{6,40}$ customer.php [QSA,L]
RewriteRule ^api/commerce(?:/.*)?$ commerce.php [QSA,L]
RewriteRule ^api/mercadopago/webhook$ commerce.php [QSA,L]
RewriteRule ^api/webhooks/asaas$ commerce.php [QSA,L]
RewriteRule ^api/player/(?:claim|complete|command|token)$ commerce.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
